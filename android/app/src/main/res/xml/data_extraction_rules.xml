<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude everything from cloud backup AND device-to-device transfer.
     (allowBackup=false alone does not stop device-to-device transfers.) Move books with Export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
